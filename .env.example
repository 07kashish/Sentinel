# ── required ────────────────────────────────────────────────────────────────
# tenant:key:role  (roles: ingest < viewer < analyst < admin)
# Keys must be >=32 chars when SENTINEL_ENV=production, or startup refuses.
SENTINEL_API_KEYS=acme:replace-with-a-long-random-key:admin

# development | staging | production. THE ONLY environment variable the
# application consults; `Settings.from_environment` defaults it to development.
#
# `production` is not a label. It switches on refusals that cannot be satisfied
# by accident: a PostgreSQL DSN (SQLite is rejected outright), API keys of at
# least 32 characters, explicit CORS origins, Redis when more than one replica
# shares the rate limiter, and an explicit decision about limiter fail-open.
# Startup RAISES rather than downgrading.
SENTINEL_ENV=development
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
GRAFANA_PASSWORD=replace-me
KEYCLOAK_PASSWORD=replace-me

# ── optional: real integrations ─────────────────────────────────────────────
# Absent => the feature reports "unavailable". It NEVER fabricates a result.
# Free tiers, get your own key:
#   https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
#   https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
#   https://viz.greynoise.io/account
GREYNOISE_API_KEY=
OPENAI_API_KEY=

# API bearer-token verification. Supply the trusted issuer, audience and JWKS.
# This does not configure a browser OIDC redirect/login session.
SENTINEL_OIDC_ISSUER=
SENTINEL_OIDC_AUDIENCE=sentinel
SENTINEL_OIDC_ROLE_CLAIM=groups
SENTINEL_OIDC_TENANT_CLAIM=tenant
# Soft prompt-injection classifier. Default true. Leaving it true requires BOTH
# scikit-learn (pinned in requirements.txt) and the artifact below; when either
# is missing the process still starts but detection drops to rules-only, logs
# CRITICAL, and reports sentinel_detection_degraded=1.
SENTINEL_SOFT_PROMPT_DETECT=true
# Empty => evaluation/artifacts/soft_prompt_model.pkl
SENTINEL_SOFT_PROMPT_MODEL=
SENTINEL_SOFT_PROMPT_THRESHOLD=0.5

# Publish `detection_mode` on the UNAUTHENTICATED /health/ready body.
# Default false, and the default is the security position: it tells anyone who
# can reach the port when the ML detector is down. The authenticated surfaces
# (/health/diagnostics, /metrics/prometheus) always carry it. Turn this on only
# where the readiness port is genuinely cluster-internal.
SENTINEL_READY_EXPOSE_DETECTION_MODE=false

# ── SIEM delivery ───────────────────────────────────────────────────────────
# HTTPS collector for real-time export (Splunk HEC, Elastic, Datadog, or any
# endpoint accepting ECS JSON). Empty (the default) means NO export intent is
# enqueued at all -- not that exports are enqueued and dropped.
#
# When set, each incident commits an export intent in the SAME transaction as
# the incident itself, and the transactional outbox owns delivery: retry,
# backoff, lease recovery and dead-lettering. A non-2xx from the collector
# fails the attempt and keeps the row on the retry budget; it is never
# laundered into "delivered". The CLI's file/stdout export remains available
# for deployments that already run a collector agent.
SENTINEL_SIEM_WEBHOOK_URL=
SENTINEL_SIEM_WEBHOOK_TOKEN=

# Additional SIEM sinks. Configuring one alongside the webhook FANS OUT to both.
#
# The fan-out chooses duplicate-over-loss: if any sink fails, the record stays
# on the outbox retry budget, so the sinks that already succeeded see the event
# again. Every transport carries an idempotency key so a redelivery is
# identifiable as the same event rather than as a second one.

# OTLP/HTTP logs. The standard aggregation point in most enterprises that have
# one. JSON encoding (application/json), which OTLP defines and collectors
# accept -- no protobuf code generation and no dependency.
SENTINEL_SIEM_OTLP_URL=
SENTINEL_SIEM_OTLP_TOKEN=
SENTINEL_SIEM_OTLP_SERVICE_NAME=sentinel

# RFC 5424 syslog over TLS (RFC 5425), for QRadar and most on-premises SIEMs.
# Octet-counted framing, not newline framing: the message body is JSON and
# contains no newlines only by convention, so a receiver using newline framing
# would split a record wherever a detail value happened to contain one.
# TLS is not optional and the certificate is verified -- a syslog stream is the
# audit trail in transit, readable by anyone on the path in the clear and
# writable by them unverified.
SENTINEL_SIEM_SYSLOG_HOST=
SENTINEL_SIEM_SYSLOG_PORT=6514
SENTINEL_SIEM_SYSLOG_APP_NAME=sentinel

# Kafka is NOT_SUPPORTED by this build, and setting SENTINEL_SIEM_KAFKA_* is a
# start-up ERROR rather than a silent no-op. A Kafka producer is a broker
# protocol client with its own pooling, partitioner and retry semantics; there
# is no honest way to add one without a dependency, and a transport that quietly
# posted to a REST proxy would not be Kafka. Ship to Kafka from your collector.

# ── MCP gateway ─────────────────────────────────────────────────────────────
# Require an MCP server's tools to be PINNED before a call to it is allowed.
# Default true, and true is the position: an unpinned tool is one nobody
# reviewed, and the pin is the only thing that detects a tool whose definition
# changed after approval while keeping the same name.
#
# Setting it false is the OBSERVE-mode escape for a rollout where an operator is
# still discovering which servers exist. It relaxes the PIN check ONLY -- server
# trust and description scanning are unaffected, and a server nobody enrolled is
# refused either way.
#
# Enrolment is CLI-only, deliberately; there is no HTTP route that grants an MCP
# server trust, because a credential able to enrol its own server could enrol a
# hostile one:
#   python -m sentinel.interface.cli mcp-enrol <tenant> <server> tools.json [endpoint]
#   python -m sentinel.interface.cli mcp-list  <tenant>
#   python -m sentinel.interface.cli mcp-block <tenant> <server>
# See docs/MCP_GATEWAY.md.
SENTINEL_MCP_REQUIRE_PIN=true

# ── MCP wire proxy ──────────────────────────────────────────────────────────
# When true, /v1/mcp/proxy/{server_id} is registered and this process forwards
# JSON-RPC to ENROLLED MCP servers, evaluating tools/call against the server's
# LIVE definition and refusing drifted tool listings. OFF by default: the proxy
# is an outbound network capability and must be switched on deliberately. When
# off, the route is not registered at all (a scanner sees 404), and the
# evaluation API keeps working unchanged.
SENTINEL_MCP_PROXY_ENABLED=false
# Comma-separated hostnames the proxy may dial, applied ON TOP of enrolment:
# a server must be enrolled AND (when this list is non-empty) its endpoint's
# host must appear here. Empty means any enrolled public HTTPS host.
SENTINEL_MCP_PROXY_ALLOWED_HOSTS=
# Permit the proxy to dial RFC1918/loopback endpoints, for on-prem MCP servers.
# Enable only together with a narrowed SENTINEL_MCP_PROXY_ALLOWED_HOSTS —
# an enrolled endpoint of http://169.254.169.254 must not become SSRF.
SENTINEL_MCP_PROXY_ALLOW_PRIVATE=false
# Refuse to forward a JWT upstream credential whose aud claim names no origin
# matching the enrolled endpoint (MCP authorization spec resource binding,
# RFC 8707). Structural inspection only — Sentinel holds no upstream keys and
# verifies no signatures; opaque tokens are not inspectable and always pass.
SENTINEL_MCP_PROXY_REQUIRE_TOKEN_AUDIENCE=true
# Seconds a server's tools/list may be reused when evaluating tools/call.
# 0 (default) fetches the LIVE listing on every call — most rug-pull-sensitive.
# Non-zero trades a detection window of at most this many seconds for one
# fewer upstream round trip per call. Per-process cache.
SENTINEL_MCP_PROXY_DEFINITION_CACHE_SECONDS=0
# Relay an MCP server's progress and log notifications to the client while a
# tools/call runs, when the client sends `Accept: text/event-stream`. Each
# notification is inspected before release; server-initiated requests
# (sampling, elicitation, roots) are never relayed. false (default) returns
# only the final result. The final result is inspected either way.
SENTINEL_MCP_PROXY_STREAMING=false

# ── Console demo access ──────────────────────────────────────────────────────
# A VIEWER key from SENTINEL_API_KEYS that the console publishes on its sign-in
# page, so a link can be shared with people who hold no credential. Anyone
# with the link holds it. The service refuses to start if it is any role but
# viewer. Empty (default) publishes nothing.
SENTINEL_CONSOLE_DEMO_TOKEN=

# ── Model advisor (optional, advisory only) ──────────────────────────────────
# An HTTPS model endpoint Sentinel may consult for investigation summaries.
# It never decides, approves or executes: the control path stays deterministic.
# All three or none; the endpoint must be https:// with no userinfo, query or
# fragment. The token is held in memory and excluded from every repr and log.
# The advisor through a locally signed-in agent CLI instead of an HTTP endpoint:
# the absolute path of Antigravity's `agy` plus SENTINEL_ADVISOR_MODEL (a name
# from `agy models`). Mutually exclusive with ENDPOINT/TOKEN. The CLI runs
# sandboxed, in an empty directory, with HOME and PATH only; the account that
# ran `agy` and signed in on this host is the account that answers.
# SENTINEL_ADVISOR_CLI_COMMAND=
# The HOME the CLI runs with (where its sign-in lives); defaults to this process's HOME.
# SENTINEL_ADVISOR_CLI_HOME=

# Pipeline threads in THIS process (default 4, 0-32). 0 = API only: incidents are
# admitted and queued here and processed by another replica -- e.g. the one host
# that has the advisor CLI signed in.
# SENTINEL_PIPELINE_WORKERS=4

SENTINEL_ADVISOR_ENDPOINT=
SENTINEL_ADVISOR_MODEL=
SENTINEL_ADVISOR_TOKEN=

# ── Real tool adapters ───────────────────────────────────────────────────────
# The inline tool proxy ships with only `echo` and `noop` registered. Real
# effects are registered ONLY where configured, and an unconfigured adapter is
# ABSENT rather than present-and-disabled -- the proxy already refuses unknown
# tools, so the safe state is enforced by code rather than by a flag one boolean
# away from being on.

# Directory that read_file / write_file are confined to. Empty => neither tool
# is registered. There is deliberately no default: the obvious one is the
# working directory, which is the whole application. Paths are resolved and THEN
# checked for containment, so traversal and symlinks are both covered.
SENTINEL_TOOL_FILE_ROOT=

# Comma-separated hosts the http_request tool may reach. Empty => the tool is
# not registered. An allowlist is required rather than optional: the hardened
# client already refuses private and link-local addresses, but "any public host"
# is still an egress channel, and an agent talked into exfiltrating data does
# not need a private address to do it.
SENTINEL_TOOL_HTTP_ALLOWED_HOSTS=

# ── Tier-1 platform tool adapters (AWS / GitHub / Kubernetes / PostgreSQL) ────
#
# These give an agent real reach into production, so they follow the strictest
# rule in this file: NO ENABLE FLAG. A platform whose settings are all unset has
# NO adapter built and the inline proxy refuses its tool as unregistered. There
# are credentials, or there is no adapter -- a flag would be one boolean away
# from granting an agent AWS.
#
# Setting SOME of a platform's required variables is a START-UP ERROR, not a
# silent absence. An operator who half-configures AWS has said what they wanted;
# quietly building nothing would leave them believing the adapter is live until
# the first refusal, which is during an incident.
#
# CEILING is the containment that survives a policy mistake. It is the highest
# semantic tier the adapter will PERFORM, checked after ProtectGate has already
# said ALLOW, against what the request RESOLVED to rather than how it was
# described. Values: low | moderate | high | critical.
#
#   low       read-only  (the default when omitted, and the right default)
#   moderate  ordinary writes
#   high      deletions, merges, releases, unbounded UPDATE/DELETE
#   critical  IAM policy changes, branch protection, RBAC, DROP, secret reads
#
# Leave the ceiling at low unless an agent has a demonstrated need. An operator
# who sets `critical` is granting privilege escalation to whatever talks their
# agent into asking for it.
#
# Every secret below also accepts a `_FILE` variant naming a path (Kubernetes
# secret mount), so the credential need not sit in the process environment where
# every child process inherits it. The direct variable wins when both are set.

# AWS. Region is validated by shape because it becomes part of the endpoint
# hostname and the SigV4 credential scope. Prefer a short-lived assumed role
# (set SESSION_TOKEN) over a long-lived access key.
# Addressable services: iam, sts, ec2, secretsmanager, kms, ssm, cloudtrail.
# S3 is deliberately NOT addressable -- see sentinel/infrastructure/platforms/aws.py.
SENTINEL_AWS_ACCESS_KEY_ID=
SENTINEL_AWS_SECRET_ACCESS_KEY=
SENTINEL_AWS_REGION=
SENTINEL_AWS_SESSION_TOKEN=
SENTINEL_AWS_CEILING=low
# Constrained credentials. Set to make the key above a broker that may only
# sts:AssumeRole this role (and cloudtrail:LookupEvents). Each operation then
# runs under its own 15-minute session named after the operation, which is
# also how CloudTrail attributes it for automatic reconciliation.
SENTINEL_AWS_EXECUTOR_ROLE_ARN=

# GitHub. API_HOST is configuration and never an argument: a token presented to
# a host an agent chose is a disclosed token. Set it for GitHub Enterprise.
SENTINEL_GITHUB_TOKEN=
SENTINEL_GITHUB_API_HOST=api.github.com
SENTINEL_GITHUB_CEILING=low
# GitHub App mode, INSTEAD of SENTINEL_GITHUB_TOKEN: no standing token exists.
# Each operation mints an installation token scoped to the one repository and
# permission family its path names. The key file is the App's PEM private key.
SENTINEL_GITHUB_APP_ID=
SENTINEL_GITHUB_INSTALLATION_ID=
SENTINEL_GITHUB_APP_PRIVATE_KEY_FILE=
# The PEM itself is accepted too; prefer the _FILE form so the key is not in the environment.
SENTINEL_GITHUB_APP_PRIVATE_KEY=

# Kubernetes. A cluster API server is normally on a private address, which the
# hardened outbound client refuses by default. That is NOT worked around: also
# set SENTINEL_TOOL_HTTP_ALLOWED_HOSTS (or the outbound policy) to permit this
# ONE host, which is a far smaller grant than all of RFC1918.
# exec / attach / port-forward are unreachable at any ceiling.
SENTINEL_KUBERNETES_API_SERVER=
SENTINEL_KUBERNETES_TOKEN=
SENTINEL_KUBERNETES_CEILING=low
# Constrained credentials. Set BOTH to make SENTINEL_KUBERNETES_TOKEN a broker
# that may only mint short-lived tokens (TokenRequest) for this one service
# account. Every operation then runs under its own token, and what it may touch
# is that account's RBAC. TTL is 600-3600 seconds; the audience is optional.
SENTINEL_KUBERNETES_EXECUTOR_SERVICE_ACCOUNT=
SENTINEL_KUBERNETES_EXECUTOR_NAMESPACE=
SENTINEL_KUBERNETES_TOKEN_TTL_SECONDS=600
SENTINEL_KUBERNETES_TOKEN_AUDIENCE=
# The cluster CA bundle. In a pod: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# The adapter's client may reach ONLY the API server's host, private or not.
SENTINEL_KUBERNETES_CA_FILE=

# PostgreSQL. This is the database AGENTS may query -- NOT Sentinel's own store.
# Pointing it at SENTINEL_DATABASE_URL is refused at start-up: it would hand
# agents a cursor over the incidents, evidence and audit trail that exist to
# describe them, and read-only is not a mitigation because the value of that
# data is in reading it.
# Every statement runs in a READ ONLY transaction with this timeout, enforced by
# PostgreSQL rather than by Sentinel -- the containment that does not depend on
# Sentinel being right about SQL.
SENTINEL_POSTGRES_DSN=
SENTINEL_POSTGRES_STATEMENT_TIMEOUT_MS=5000
SENTINEL_POSTGRES_CEILING=low

# Refuse a tool call from an agent that was never granted it.
#
# Defaults to FALSE (observe mode), unlike the MCP pin requirement which
# defaults to on. The difference is deliberate: MCP enrolment was new, so
# requiring pins broke nothing, while agents already exist in every deployment.
# Defaulting to deny would stop every working agent on upgrade, and the
# predictable response is switching it off permanently -- off AND unwatched,
# which is worse than an honest observe mode.
#
# In observe mode an ungranted call is ALLOWED and the decision records
# enforced=false, so "allowed" is never mistaken for "authorised". Grant
# capabilities, watch what agents actually invoke, then turn this on:
#
#   python -m sentinel.interface.cli agent-grant  <tenant> <agent> <tool>...
#   python -m sentinel.interface.cli agent-grants <tenant>
SENTINEL_AGENT_REQUIRE_GRANT=

# ── Evidence encryption ──────────────────────────────────────────────────────
# Evidence BODIES are sealed per record (AES-256-GCM, a data key per record
# wrapped by the key below, bound to the tenant and incident). Generate a key:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Rotation: add SENTINEL_DATA_KEY_<new>, point SENTINEL_ACTIVE_KEY_ID at it,
# restart, run `python -m sentinel.interface.cli evidence-reseal <tenant>` until it
# reports 0, then remove the old key. Losing every key loses the bodies; the
# digests and the transparency log still verify.
# Production refuses to start with neither a key nor an explicit `off`.
SENTINEL_DATA_KEY_K1=
SENTINEL_ACTIVE_KEY_ID=
SENTINEL_EVIDENCE_ENCRYPTION=

# ── Protected-change workflow ────────────────────────────────────────────────
# true: only a credential issued to an agent by a registered identity provider
# or workload attestor (SENTINEL_AGENT_IDP_JSON kinds okta, entra, generic,
# spiffe, kubernetes) may use the agent path. An API key is refused there,
# because anything holding it could type any agent's name.
SENTINEL_REQUIRE_WORKLOAD_IDENTITY=false
# An agent issuer in SENTINEL_AGENT_IDP_JSON may carry "jwks_uri" (https) instead of,
# or as well as, pinned "jwks": keys are refreshed every "jwks_refresh_seconds"
# (300-86400, default 3600) and once a minute at most when an unseen key id appears.
# Or "discover": true to read the jwks_uri from <issuer>/.well-known/openid-configuration
# (SPIRE's OIDC Discovery Provider, Okta, Entra); the document must name exactly this issuer.
# A failed fetch keeps the last good keys. "jwks_private_host": true permits an
# internal issuer address, for that one host only.
# Distinct human approvers required before a pending authorization activates.
SENTINEL_APPROVAL_QUORUM=1
# true: whoever requested an authorization may not approve it.
SENTINEL_APPROVAL_SEPARATION_OF_DUTIES=true
# Automatic target lookups per unknown operation before a human is asked.
SENTINEL_RECONCILE_MAX_ATTEMPTS=5

# ── Per-tenant SIEM sinks (Phase 13) ─────────────────────────────────────────
#
# WHY THIS EXISTS. `SENTINEL_SIEM_WEBHOOK_URL` is process-wide: one deployment,
# one endpoint, every tenant. Correct for a single-tenant install. In
# multi-tenant SaaS it means tenant A's incidents -- agent names, resource
# paths, prompt fragments -- are delivered to whatever endpoint the operator
# configured, which belongs to somebody else. No row-level security policy
# catches it: the data leaves through a correctly-authorised path.
#
# Setting this REPLACES the process-wide sink rather than adding to it. Both at
# once would send every tenant's events to the shared endpoint as well as their
# own, which is the same disclosure happening where it is harder to notice.
#
# A tenant absent from this list exports NOWHERE. It does not fall back. The
# tenant most likely to be missing is a NEW one, and a new tenant silently
# shipping its first incidents to an existing customer's SIEM is the worst
# possible first day -- so an unconfigured tenant fails its export loudly, keeps
# the record on its retry budget, and surfaces in the dead-letter queue.
#
# Format: tenant=endpoint|credential_ref, semicolon-separated. The credential
# reference is a key in a secret store, never the secret; a value that LOOKS
# like a token is refused at construction.
#
# Resolve each credential_ref through the configured tenant SIEM secret provider.
# Verify authenticated delivery for each tenant before relying on this export.
# SENTINEL_TENANT_SIEM_SINKS=acme=https://acme.example/ingest|secrets/acme-siem;globex=https://globex.example/ingest

# ── optional: transparency root publication to S3 Object Lock ───────────────
# WHY: the Merkle log detects deletion, reordering and forked histories against
# everyone EXCEPT the party running it -- that party serves both the history
# and the root you check it against. Publishing the root somewhere its writer
# cannot alter is what closes that, and it is the only reason to involve S3.
#
# UNSET => RefusingRootSink. Nothing is published, and
# /v1/transparency/root honestly answers independently_verifiable: false.
# That is a supported state, not a broken one.
#
# Costs and retention consequences must be measured for the selected deployment.
# No production cost or independent-storage claim follows from this example.
#
# Verify Object Lock and retention on the actual bucket before enabling publication.
# This example is not proof that independent immutable storage is configured.
SENTINEL_S3_ROOT_BUCKET=
SENTINEL_S3_ROOT_REGION=
# Prefer a role with a session token over a long-lived user. If you must use a
# user, give it ONLY s3:PutObject and s3:PutObjectRetention on this one prefix.
SENTINEL_S3_ROOT_ACCESS_KEY_ID=
SENTINEL_S3_ROOT_SECRET_ACCESS_KEY=
SENTINEL_S3_ROOT_SESSION_TOKEN=
# Days the root cannot be deleted by anyone, including the account root.
# COMPLIANCE mode means this is irreversible: you cannot shorten it, and you
# will pay storage until it expires. 200 bytes/day for 10 years is ~0.7 MB.
SENTINEL_S3_ROOT_RETENTION_DAYS=3650
# On ECS/Fargate no static key is needed: the agent sets
# AWS_CONTAINER_CREDENTIALS_RELATIVE_URI (or _FULL_URI, with
# AWS_CONTAINER_AUTHORIZATION_TOKEN) and the sink fetches the task role's
# short-lived credential from that endpoint per request. Read, never set here.

# Additional configuration catalogue (unset retains the parser default).
# Entries below are documentation, not assignments. Inspect the named parser
# before enabling optional capabilities; secret *_FILE fields name mounted files.
# Production examples and rollout constraints: docs/current/PRODUCTION_ACCEPTANCE.md.
# SENTINEL_A2A_PROXY_ALLOWED_HOSTS — sentinel/composition/settings.py
# SENTINEL_A2A_PROXY_ALLOW_PRIVATE — sentinel/composition/settings.py
# SENTINEL_A2A_PROXY_ENABLED — sentinel/composition/settings.py
# SENTINEL_ACTIVE_KEY_ID — sentinel/infrastructure/persistence/crypto.py
# SENTINEL_ADDRESS_LIMIT — sentinel/composition/settings.py
# SENTINEL_AGENT_ID — sentinel/sdk/mcp_stdio.py
# SENTINEL_AGENT_IDP_JSON — sentinel/composition/settings_parsers.py
# SENTINEL_API_KEY — sentinel/sdk/mcp_stdio.py
# SENTINEL_ATTESTATION_ENDPOINT — sentinel/composition/settings.py
# SENTINEL_ATTESTATION_TOKEN — sentinel/composition/settings.py
# SENTINEL_AUTH_FAILURE_LIMIT — sentinel/composition/settings.py
# SENTINEL_AWS_SECRET_ACCESS_KEY_FILE — sentinel/composition/settings_parsers.py (platform/SIEM schema)
# SENTINEL_AWS_SESSION_TOKEN_FILE — sentinel/composition/settings_parsers.py (platform/SIEM schema)
# SENTINEL_BYPASS_IDLE_SECONDS — sentinel/composition/settings.py
# SENTINEL_CORS_ORIGINS — sentinel/composition/settings.py
# SENTINEL_CREDENTIAL_LIMIT — sentinel/composition/settings.py
# SENTINEL_DB_PATH — sentinel/composition/settings.py
# SENTINEL_DB_POOL_MAX — sentinel/composition/settings.py
# SENTINEL_DB_POOL_MIN — sentinel/composition/settings.py
# SENTINEL_DELEGATION_KEYS — sentinel/composition/settings.py
# SENTINEL_DETONATION_IMAGE — sentinel/composition/settings.py
# SENTINEL_DETONATION_TRACING — sentinel/composition/settings.py
# SENTINEL_EXPOSE_API_DOCS — sentinel/composition/settings.py
# SENTINEL_GITHUB_TOKEN_FILE — sentinel/composition/settings_parsers.py (platform/SIEM schema)
# SENTINEL_INCIDENT_RETENTION_DAYS — sentinel/composition/settings.py
# SENTINEL_KUBERNETES_TOKEN_FILE — sentinel/composition/settings_parsers.py (platform/SIEM schema)
# SENTINEL_LOG_LEVEL — sentinel/composition/settings.py
# SENTINEL_METRICS_TOKEN — sentinel/composition/settings_parsers.py
# SENTINEL_METRICS_TOKEN_FILE — sentinel/composition/settings_parsers.py
# SENTINEL_OIDC_JWKS_JSON — sentinel/composition/settings.py
# SENTINEL_OPERATION_PENDING_DEADLINE_SECONDS — sentinel/composition/settings.py
# SENTINEL_OTLP_ENDPOINT — sentinel/composition/settings.py
# SENTINEL_OUTBOX_BATCH — sentinel/composition/settings.py
# SENTINEL_OUTBOX_LEASE_SECONDS — sentinel/composition/settings.py
# SENTINEL_POSTGRES_DSN_FILE — sentinel/composition/settings_parsers.py (platform/SIEM schema)
# SENTINEL_PROTECTION_MODE — sentinel/composition/settings.py
# SENTINEL_PROTECT_CIRCUIT_THRESHOLD — sentinel/composition/settings.py
# SENTINEL_PROTECT_ENFORCE — sentinel/composition/settings.py
# SENTINEL_PROTECT_KILL_SWITCH — sentinel/composition/settings.py
# SENTINEL_QUEUE_LEASE_SECONDS — sentinel/composition/settings.py
# SENTINEL_QUEUE_MAX_ATTEMPTS — sentinel/composition/settings.py
# SENTINEL_RATE_LIMIT_FAIL_OPEN — sentinel/composition/settings.py
# SENTINEL_REDIS_URL — sentinel/composition/settings.py
# SENTINEL_REGION — sentinel/composition/settings.py
# SENTINEL_REMEDIATION_DRY_RUN — sentinel/composition/settings.py
# SENTINEL_REMEDIATION_ENDPOINTS — sentinel/composition/settings_parsers.py
# SENTINEL_REPLAY_WINDOW — sentinel/composition/settings.py
# SENTINEL_REQUIRE_EXECUTION_BINDING — sentinel/composition/settings.py
# SENTINEL_RETENTION_DAYS — sentinel/composition/settings.py
# SENTINEL_RETENTION_INTERVAL — sentinel/composition/settings.py
# SENTINEL_ROOT_PUBLISH_INTERVAL_SECONDS — sentinel/composition/settings_parsers.py
