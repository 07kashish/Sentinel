# syntax=docker/dockerfile:1
# Multi-stage: build a hash-verified virtualenv once, ship a minimal non-root runtime.
#
# WHY THE BASE IS WOLFI AND NOT DEBIAN
# The Debian-based python image carried dozens of HIGH advisories with NO fixed
# version, every one in a package this service never executes: util-linux,
# login, mount, perl, ncurses, systemd libraries. `apt-get upgrade` cannot fix
# what the distribution has not fixed, and an exception list that long is a
# gate nobody reads. This base contains a C library, busybox and what is
# installed below: Python, and the C++ runtime the numeric wheels link against.
# The runtime stage has no package manager state, no pip and no compiler. The
# base is pinned by digest; move it deliberately and rescan when you do.
FROM cgr.dev/chainguard/wolfi-base@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d AS builder
RUN apk add --no-cache python-3.12 py3.12-pip
WORKDIR /build
# HASH-PINNED, BINARY-ONLY. `requirements.lock` carries the sha256 of every
# published wheel that `requirements.txt` resolves to, so a package whose
# bytes differ from what was audited is refused here rather than installed.
# `--only-binary=:all:` means nothing is ever built from an sdist in this
# image: a built wheel has a hash nobody audited, and the lock would refuse
# it anyway. The lock is regenerated by the command in its header whenever
# requirements.txt changes; the release-hygiene CI job fails if they drift.
COPY requirements.lock .
RUN python3.12 -m pip download --no-cache-dir --require-hashes --only-binary=:all: \
        --dest /wheels -r requirements.lock
# Installed HERE, into a virtualenv the runtime stage copies, so the runtime
# never contains pip. Hashes are required again at install: the download and
# the install are separate trust decisions.
RUN python3.12 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-index --find-links=/wheels \
        --require-hashes -r requirements.lock \
    && /opt/venv/bin/pip uninstall -y pip \
    && rm -rf /wheels

# Source validation is separate so code changes cannot invalidate the locked
# dependency download layer. Its received file set is validated before use.
FROM cgr.dev/chainguard/wolfi-base@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d AS source
RUN apk add --no-cache python-3.12
WORKDIR /context
COPY . .
RUN python3.12 -B scripts/check_container_context.py --root /context

FROM cgr.dev/chainguard/wolfi-base@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH=/opt/venv/bin:$PATH
# Python, and libstdc++ for the scikit-learn/scipy wheels. Nothing else.
RUN apk add --no-cache python-3.12 libstdc++ \
    && rm -rf /var/cache/apk/*
# Run as non-root. A security product running as root fails its own review.
RUN addgroup -g 10001 sentinel && adduser -D -u 10001 -G sentinel -h /app sentinel
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY requirements.lock .
COPY --from=source --chown=sentinel:sentinel /context/sentinel ./sentinel
COPY --from=source --chown=sentinel:sentinel /context/config ./config
COPY --from=source --chown=sentinel:sentinel /context/scripts ./scripts
COPY --from=source --chown=sentinel:sentinel /context/evaluation ./evaluation
COPY --from=source --chown=sentinel:sentinel /context/standard ./standard
COPY --from=source --chown=sentinel:sentinel /context/docker-entrypoint.sh /context/LICENSE ./
# Durable state lives on a volume, not in the image layer.
RUN mkdir -p /app/data && chown sentinel:sentinel /app/data \
    && chmod 0755 /app/docker-entrypoint.sh
VOLUME ["/app/data"]
# /tmp is declared a volume so an orchestrator that runs the container with a
# read-only root filesystem and mounts an empty volume here (ECS Fargate does
# both) gives it the image's ownership and mode. Without this the mount is
# root-owned and the non-root process has no writable temp directory at all:
# gunicorn's first worker died with "No usable temporary directory found" on
# the first real Fargate deployment.
RUN chmod 1777 /tmp
VOLUME ["/tmp"]

USER sentinel
# Import as the same non-root UID used by Helm before accepting the image.
# The compiled dependencies are imported too: a missing shared library shows up
# here, at build time, and not as a crash on the first request that needs it.
RUN python -c "import sentinel.composition.container, sentinel.interface.http, sentinel.interface.cli, psycopg, cryptography.hazmat.bindings._rust, sklearn, gunicorn, uvicorn"
EXPOSE 8000
# /health/live is the only unauthenticated route, so it is the correct probe target.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live',timeout=4).status==200 else 1)"
# The worker count is decided in the entrypoint by the same rule the app
# enforces: one process without a shared rate limiter, four with one. A
# hard-coded `--workers 4` here was refused by the application's own topology
# check in every deployment that had no Redis, the CI smoke test included.
ENTRYPOINT ["/app/docker-entrypoint.sh"]
